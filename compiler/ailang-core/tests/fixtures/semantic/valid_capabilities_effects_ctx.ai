fn ok(ctx: Ctx, db: DbCap, net: NetCap, internal: InternalNetCap, sec: SecretsCap, fs: FsCap, writeQuery: SqlQuery, readQuery: SqlQuery, publicUrl: PublicUrl, internalUrl: InternalUrl, path: PathSafe) effects { db.read, db.write, net, secrets.read, fs.read, fs.write } -> Int {
  db.exec(ctx, db, writeQuery);
  db.queryOne(ctx, db, readQuery, "Row");
  httpClient.get(ctx, net, publicUrl);
  httpClient.getInternal(ctx, internal, internalUrl);
  secrets.get(ctx, sec, "TOKEN");
  fs.read(ctx, fs, path);
  fs.write(ctx, fs, path, "payload");
  1
}
