fn ok(ctx: Ctx, db: DbCap, net: NetCap, sec: SecretsCap, writeQuery: SqlQuery, readQuery: SqlQuery, row: Schema<Int>, publicUrl: PublicUrl) effects { db.read, db.write, net, secrets.read } -> Int {
  db.exec(ctx, db, writeQuery);
  db.queryOne(ctx, db, readQuery, row);
  httpClient.get(ctx, net, publicUrl);
  secrets.get(ctx, sec, "TOKEN");
  1
}
