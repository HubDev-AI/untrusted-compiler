fn health() effects { net } -> Int {
  res.html(1);
  0
}

fn createUser(schema: Schema<Int>) effects { net } -> Int {
  auth.require(1);
  auth.requireRole(1, 2);
  csrf.issueToken(1);
  req.body(1, 2);
  req.query(1, 2);
  req.pathParam(1, 2);
  let origin = req.header(1, 2);
  cors.origin(origin);
  req.json(schema);
  res.json(schema, 1);
  res.ok(201, schema, 1);
  res.okMeta(201, schema, 1, 2);
  0
}

fn main() effects { net } -> Int {
  sec.defaultHeaders();
  cors.fromPolicy();
  csrf.fromPolicy();
  auth.fromPolicy();
  sec.withSecurityHeaders();
  cors.withCors();
  csrf.withCsrf();
  auth.withAuth();
  let router = http.router();
  http.get(router, 1, 1);
  http.post(router, 1, 1);
  http.serve(1, router);
  0
}
