// showcase_fs
//
// Deterministic file-system lanes for the LASM alpha showcase.
//
// path.base + path.under + read/write with tracked values.

fn roundtrip() effects { net, fs.write, fs.read } -> Int {
  // Query args:
  //   file=<relative file path>
  //   value=<text value>
  let base = path.base("/tmp/lasm-alpha-showcase");
  let fileArg = req.query("file");
  let value = validate.nonEmpty(req.query("value"));
  let file = path.under(base, fileArg);
  let fs = FsCap();

  fs.write(fs, file, value);
  let loaded = fs.read(fs, file);
  if loaded == 0 {
    res.text(500, "fs read returned empty handle");
    return 0;
  };

  res.text(200, "fs roundtrip completed");
  0
}

fn inspect() effects { net } -> Int {
  // Query args:
  //   file=<relative file path>
  // Returns a deterministic "allowed/denied" marker for containment checks.
  let base = path.base("/tmp/lasm-alpha-showcase");
  let fileArg = req.query("file");
  let file = path.under(base, fileArg);

  let _ = file;
  res.text(200, "path under validated");
  0
}
