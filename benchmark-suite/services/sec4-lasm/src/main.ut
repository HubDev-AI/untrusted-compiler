fn ping() effects { net } -> Int {
  res.text(200, "ok");
  0
}

fn dbHotWrite() effects { net, db.write } -> Int {
  let db = DbCap();
  let query = sql.q(
    "create table if not exists sec4_bench_records (id text primary key, payload text)",
    "[]"
  );
  db.exec(db, query);
  db.exec(
    db,
    sql.q(
      "insert into sec4_bench_records(id, payload) values (?, ?) on conflict (id) do update set payload = excluded.payload",
      "bench-hot,active"
    )
  );
  res.json(200, "DbExecResponse", 0);
  0
}

fn dbHotWriteTx() effects { net, db.write, db.tx } -> Int {
  let db = DbCap();
  db.exec(
    db,
    sql.q(
      "create table if not exists sec4_bench_records (id text primary key, payload text)",
      "[]"
    )
  );
  let tx = db.tx(db);
  db.execTx(
    tx,
    sql.q(
      "insert into sec4_bench_records(id, payload) values (?, ?) on conflict (id) do update set payload = excluded.payload",
      "bench-hot-tx,active"
    )
  );
  res.json(200, "DbExecTxResponse", 0);
  0
}

fn dbListRecords() effects { net } -> Int {
  res.json(200, "DbListRecordsResponse", 0);
  0
}

fn decodeUser() effects { net } -> Int {
  req.json("UserRequest");
  res.ok(200, "DecodeResponse", 0);
  0
}

fn createUser() effects { net } -> Int {
  req.json("UserRequest");
  res.ok(201, "CreateUserResponse", 0);
  0
}

fn getUser() effects { net } -> Int {
  req.pathParam("id");
  res.json(200, "UserResponse", 0);
  0
}

fn main() effects { net } -> Int {
  let router = http.router();

  http.get(router, "/ping", ping);
  http.get(router, "/health", ping);
  http.post(router, "/decode", decodeUser);
  http.post(router, "/users", createUser);
  http.get(router, "/users/:id", getUser);
  http.get(router, "/db/hot-write", dbHotWrite);
  http.get(router, "/db/hot-write-tx", dbHotWriteTx);
  http.get(router, "/db/records", dbListRecords);

  http.serve(8080, router);
  0
}
