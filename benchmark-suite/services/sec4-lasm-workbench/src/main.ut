use workbench.common;
use workbench.comments;
use workbench.records;
use workbench.setup;
use workbench.tasks;

fn main() effects { net } -> Int {
  let router = http.router();

  http.get(router, "/health", health);

  http.post(router, "/wb/setup", wbSetup);
  http.post(router, "/wb/tasks", wbCreateTask);
  http.post(router, "/wb/tasks/with-comment", wbCreateTaskWithComment);
  http.post(router, "/wb/tasks/with-comment-tx", wbCreateTaskWithCommentTx);
  http.post(router, "/wb/tasks/:id/comments", wbAddComment);
  http.get(router, "/wb/tasks/:id", wbGetTask);
  http.get(router, "/wb/tasks", wbListTasksWindow);
  http.get(router, "/wb/records", wbRecords);

  http.serve(8080, router);
  0
}
