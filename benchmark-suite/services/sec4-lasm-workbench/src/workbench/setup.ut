fn wbSetup() effects { net, db.write } -> Int {
  auth.require(ctx.current());
  let db = DbCap();

  // Reset benchmark tables so each setup starts from a deterministic state.
  db.exec(db, sql.q("drop table if exists wb_labels", "[]"));
  db.exec(db, sql.q("drop table if exists wb_comments", "[]"));
  db.exec(db, sql.q("drop table if exists wb_tasks", "[]"));

  db.exec(
    db,
    sql.q(
      "create table if not exists wb_tasks (id text primary key, title text not null, description text not null default '', status text not null check (status in ('open', 'in_progress', 'done')), priority integer not null check (priority between 1 and 5), created_at_ms bigint not null)",
      "[]"
    )
  );
  db.exec(
    db,
    sql.q(
      "create table if not exists wb_comments (id text primary key, task_id text not null references wb_tasks(id), body text not null, created_at_ms bigint not null)",
      "[]"
    )
  );
  db.exec(
    db,
    sql.q(
      "create table if not exists wb_labels (task_id text not null, name text not null, primary key(task_id, name))",
      "[]"
    )
  );
  db.exec(
    db,
    sql.q(
      "create index if not exists wb_comments_task_id_idx on wb_comments(task_id)",
      "[]"
    )
  );
  db.exec(
    db,
    sql.q(
      "create index if not exists wb_tasks_created_id_idx on wb_tasks(created_at_ms desc, id desc)",
      "[]"
    )
  );
  db.exec(
    db,
    sql.q(
      "create index if not exists wb_tasks_status_created_id_idx on wb_tasks(status, created_at_ms desc, id desc)",
      "[]"
    )
  );
  db.exec(
    db,
    sql.q(
      "create index if not exists wb_labels_name_task_id_idx on wb_labels(name, task_id)",
      "[]"
    )
  );

  res.json(200, "DbExecResponse", 0);
  0
}
